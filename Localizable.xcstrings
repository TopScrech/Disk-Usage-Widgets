    "Choose the drive itself or any folder on it to grant access" : {
      "comment" : "A description of how to add an external drive.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر محرك الأقراص نفسه أو أي مجلد عليه لمنح صلاحية الوصول"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Laufwerk selbst oder einen Ordner darauf, um Zugriff zu gewähren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la unidad o cualquier carpeta que contenga para conceder acceso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le disque lui-même ou un de ses dossiers pour autoriser l’accès"
