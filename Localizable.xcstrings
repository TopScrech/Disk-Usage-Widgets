    "Free up space soon to keep downloads, updates, and everyday tasks working reliably" : {
      "comment" : "Message for the storage status when the storage is critically low.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرّر مساحة قريبًا لضمان استمرار التنزيلات والتحديثات والمهام اليومية دون مشاكل"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib bald Speicherplatz frei, damit Downloads, Updates und alltägliche Aufgaben weiterhin zuverlässig funktionieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera espacio pronto para que las descargas, las actualizaciones y las tareas cotidianas sigan funcionando correctamente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libérez rapidement de l’espace pour assurer le bon fonctionnement des téléchargements, des mises à jour et des tâches quotidiennes"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード、アップデート、日常の操作を安定して行えるよう、早めに空き容量を確保してください"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak binnenkort ruimte vrij zodat downloads, updates en dagelijkse taken goed blijven werken"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освободите место в ближайшее время, чтобы загрузки, обновления и повседневные задачи выполнялись без сбоев"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirmelerin, güncellemelerin ve günlük işlerin sorunsuz devam etmesi için kısa süre içinde yer açın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звільніть місце найближчим часом, щоб завантаження, оновлення та повсякденні завдання виконувалися без збоїв"
          }
        }
      }
    },
