    "Consider removing downloads or unused apps before installing a large update" : {
      "comment" : "Message for the storage status when the storage is getting full.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entferne Downloads oder ungenutzte Apps, bevor du ein großes Update installierst"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensez à supprimer des téléchargements ou des apps inutilisées avant d’installer une mise à jour volumineuse"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overweeg downloads of ongebruikte apps te verwijderen voordat je een grote update installeert"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед установкой большого обновления удалите ненужные загрузки или неиспользуемые приложения"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyük bir güncelleme yüklemeden önce indirilenleri veya kullanılmayan uygulamaları silmeyi düşünün"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
