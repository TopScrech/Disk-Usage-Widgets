          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Elige Añadir widget y busca Disk Usage"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Choisissez Ajouter un widget et recherchez Disk Usage"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 「ウィジェットを追加」を選択し、Disk Usageを検索"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Kies Voeg widget toe en zoek naar Disk Usage"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Выберите «Добавить виджет» и найдите Disk Usage"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Araç Takımı Ekle’yi seçin ve Disk Usage’ı arayın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Виберіть «Додати віджет» і знайдіть Disk Usage"
          }
        }
      }
    },
    "3. Pick a size, add it, then place it where you like" : {
      "comment" : "A step in the process of adding a widget to the home screen.",
