{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "de",
      "fr",
      "nl",
      "ru",
      "tr",
      "uk",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/Appearance",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/ScrechKit",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/LaunchAtLogin",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    },
  ],
  "files": [
    { "path": "README.md" },
    { "path": "AGENTS.md" },
    {
      "kind": "folder",
      "path": "macOS",
      "target-membership": [
        "macOS",
      ],
      "membership-exceptions": [
        {
          "target": "macOS",
          "exclusions": [
            "macOS.plist",
          ],
        }, {
          "target": "Widgets",
          "inclusions": [
            "AppIcon.icon",
            "DiskEntry.swift",
            "HomeViewToolbar.swift",
            "Localizable.xcstrings",
            "Utils/FileManager.swift",
            "Utils/Preview.swift",
            "Utils/Utils.swift",
            "VM.swift",
          ],
        }, {
          "target": "iOS",
          "inclusions": [
            "AppIcon.icon",
            "Assets.xcassets",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Widgets",
      "target-membership": [
        "Widgets",
      ],
      "membership-exceptions": [
        {
          "target": "Widgets",
          "exclusions": [
            "Widgets.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "iOS",
      "target-membership": [
        "Widgets",
        "iOS",
      ],
      "membership-exceptions": [
        {
          "target": "Widgets",
          "exclusions": [
            "ContentView.swift",
            "External Drives/ExternalDriveCard.swift",
            "External Drives/ExternalDriveList.swift",
            "External Drives/ExternalDriveSnapshot.swift",
            "External Drives/SavedExternalDrive.swift",
            "Settings/SavedExternalDriveRow.swift",
            "Settings/SettingsView.swift",
            "Storage/CapacityMetricView.swift",
            "Storage/CapacitySummaryView.swift",
            "Storage/StorageGauge.swift",
            "Storage/StorageOverview.swift",
            "Storage/StorageReadError.swift",
            "Storage/StorageSnapshot + Preview.swift",
            "Storage/StorageSnapshot.swift",
            "Storage/StorageStatus.swift",
            "Storage/StorageStatusView.swift",
            "Storage/StorageUnavailableView.swift",
            "Storage/StorageVM.swift",
            "Widgets/WidgetInstructionsView.swift",
            "iOSApp.swift",
          ],
        },
      ],
    },
    { "path": "LICENSE.txt" },
    {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "Widgets/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "Widgets/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/Intents.framework" },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/macOS.app", "id": "F3CEC0012C2ABA6800B44CE4", "type": "wrapper.application", "index": false },
        {
          "path": "<PRODUCTS>/Widgets.appex",
          "id": "F397D77A2C2AEE020069F3EB",
          "type": "wrapper.app-extension",
          "index": false,
          "target-membership": [
            { "build-phase": "macOS/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" },
            { "build-phase": "iOS/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" },
          ],
        },
        { "path": "<PRODUCTS>/iOS.app", "id": "F3AC8C21301808C300DADBFE", "type": "wrapper.application", "index": false },
      ],
    },
  ],
